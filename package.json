{
  "name": "automod",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "check": "tsc --noEmit",
    "policy": "node --experimental-strip-types packages/store/src/policy-cli.ts",
    "operators": "node --experimental-strip-types packages/store/src/operator-cli.ts",
    "label": "node --experimental-strip-types packages/store/src/label-cli.ts",
